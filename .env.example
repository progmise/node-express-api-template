# GitHub OAuth App credentials (GitHub → Settings → Developer settings →
# OAuth Apps). Callback URL: <frontend-or-api-url>/api/auth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Comma-separated GitHub logins allowed to sign in (empty = any GitHub user)
ALLOWED_USERS=

# Origin of the SPA when it is a separate service — used for the OAuth
# redirect_uri, the post-login redirect, and CORS. Leave empty when the
# frontend reaches this API through a same-origin proxy.
FRONTEND_URL=

# Override CORS origin if different from FRONTEND_URL (usually leave empty)
CORS_ORIGIN=

# Local run port (Vercel sets PORT at runtime)
PORT=8080
